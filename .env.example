# FirstDayFirstShow — copy to .env for local runs. Real values live only in .env (gitignored)
# and in the Render dashboard (render.yaml marks them sync:false).

# ---------- Server ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---------- Database (Supabase Postgres 17, Singapore) ----------
# Supabase's direct host is IPv6-only, which Render can't reach — always go through the pooler host.
# Transaction pooler (port 6543) — used by the app at runtime (prepared statements off).
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Session pooler (port 5432) — used by migrations. Defaults to DATABASE_URL when unset.
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# App-side pool size; keep below the pooler's client limit for your Supabase compute tier.
DB_POOL_MAX=20
# A request's DB call that takes longer than this answers 503 db_unavailable instead of hanging
# (behind a pooler, an unreachable Postgres otherwise looks like a long queue wait).
DB_REQUEST_TIMEOUT_MS=10000
# Informational: which Supabase project this deploy talks to.
SUPABASE_PROJECT_REF=<project-ref>

# ---------- Auth ----------
# HS256 signing secret for the demo login's JWTs — 32+ random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=<PLACEHOLDER>
# Bearer key for admin endpoints (POST /shows). Shared with graders out of band, never committed.
ADMIN_API_KEY=<PLACEHOLDER>
# Open demo login (POST /auth/login, /auth/tokens). Stand-in for a real IdP.
AUTH_DEMO_LOGIN=true

# ---------- Reservation behaviour ----------
DEFAULT_PER_USER_LIMIT=4
MAX_SEATS_PER_SHOW=20000
HOLD_SWEEP_INTERVAL_MS=1000
# Admission control high-water mark: requests queued beyond this get 429 + Retry-After.
MAX_QUEUE=20000
# GET /shows/:id serves one serialized snapshot per show for this long (ms); 0 disables.
SNAPSHOT_CACHE_MS=250

# ---------- Realtime (GET /stream, server-sent events) ----------
# Concurrent SSE connections this instance accepts; beyond it, 503 + Retry-After.
STREAM_MAX_CLIENTS=2000
# Seat changes are coalesced per show for this long (ms), then pushed as one delta.
STREAM_COALESCE_MS=100
# Comment frame keeping idle connections open through proxies (ms).
STREAM_HEARTBEAT_MS=15000
# Every subscribed show also gets a full snapshot this often (ms): a safety net, not the mechanism.
STREAM_RESYNC_MS=30000

# ---------- Background jobs ----------
# Invariant + audit check of recently active shows (ms).
RECONCILE_INTERVAL_MS=5000
# Janitor: deletes old ephemeral (burst/simulator) shows and old idempotency keys (ms).
JANITOR_INTERVAL_MS=600000
EPHEMERAL_SHOW_TTL_HOURS=24
IDEMPOTENCY_KEY_TTL_HOURS=24

# ---------- Tests ----------
# Unset: tests boot an embedded Postgres 17. Set: tests run against this database instead (CI, Supabase).
# TEST_DATABASE_URL=
