    {
      "type": "timeseries",
      "title": "Reserve responses by outcome",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "fdfs-prometheus"
      },
      "description": "Every POST /shows/:id/reserve response: created, replayed, or the error code.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fdfs-prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(fdfs_reserve_responses_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 18,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
