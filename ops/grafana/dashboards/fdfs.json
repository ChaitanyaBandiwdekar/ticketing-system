{
  "uid": "fdfs-overview",
  "title": "FDFS overview",
  "tags": ["fdfs"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "description": "FirstDayFirstShow: correctness, traffic, saturation. Alerts live in ops/alerts.yml.",
